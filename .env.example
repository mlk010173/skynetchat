# ============ FRONTEND (valores públicos, assados no build do export estático) ============
# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima (pública por design — protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Prefixo quando hospedado em subcaminho (GitHub Pages: /skynetchat). Vazio para domínio próprio.
NEXT_PUBLIC_BASE_PATH=/skynetchat

# ============ EDGE FUNCTIONS (secrets no dashboard do Supabase, nunca no frontend) ============
# Chave do provedor de IA (OpenAI, Groq, OpenRouter…)
OPENAI_API_KEY=
# Opcional — base URL do provedor. Ex. Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# Opcional — modelos do seletor, separados por vírgula
SKYNET_MODELS=gpt-4o-mini,gpt-4o
